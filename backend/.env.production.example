# ==============================================================
# VARIABLES DE ENTORNO — PRODUCCIÓN
# Copiar este archivo como .env en el servidor y completar valores
# NUNCA subir el .env real al repositorio
# ==============================================================

# Django Core
DEBUG=False
SECRET_KEY=GENERAR-UNA-CLAVE-SEGURA-CON-50-CARACTERES-MINIMO

# Hosts permitidos (sin espacios)
ALLOWED_HOSTS=avilamotorepuesto.com.ar,www.avilamotorepuesto.com.ar,pos.avilamotorepuesto.com.ar

# Base de datos PostgreSQL
USE_SQLITE=False
DB_NAME=avilapos
DB_USER=avilapos_user
DB_PASSWORD=CONTRASENA-SEGURA-POSTGRES
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME=480
JWT_REFRESH_TOKEN_LIFETIME=10080

# Google OAuth (para login en tienda web — opcional)
GOOGLE_CLIENT_ID=

# Mercado Pago (para pagos en tienda web — opcional)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Email (notificaciones — opcional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=APP-PASSWORD-GMAIL

# Configuraciones del negocio
UMBRAL_STOCK_BAJO=2
UMBRAL_MARGEN_BAJO=5.0
DESCUENTO_MAX_CAJERO=50.0
PERMITIR_STOCK_NEGATIVO=False

# Uploads
MAX_UPLOAD_SIZE=10485760
